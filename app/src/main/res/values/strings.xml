    <!-- ===== Consent before the first mining start (Consent.VERSION in miner-core, ConsentTest hashes these texts) ===== -->
    <string name="consent_kick">Before starting</string>
    <string name="consent_title">Before you start</string>
    <string name="consent_beta_head">Beta software</string>
    <string name="consent_beta">CorePulse is beta software by Tell Me More About Core. The license and liability terms apply.</string>
    <string name="consent_load_head">Battery &amp; heat</string>
    <string name="consent_load">While mining, your phone computes at the power you chose, at full load with “All”. The phone gets warm, the battery is put under more strain and drains faster when not charging. If the battery gets too warm, the app pauses by itself. You pay for the electricity to charge it.</string>
    <string name="consent_share_head" formatted="false">Support share 0.42%</string>
    <string name="consent_share" formatted="false">0.42% of the computing time supports further development (TMMAC). This share is built in and cannot be switched off.</string>
    <string name="consent_earn_head">No guaranteed earnings</string>
    <string name="consent_earn">Earnings vary and are not guaranteed. Mined XCB may be taxable.</string>
    <string name="consent_pool_head">What the pool sees</string>
    <string name="consent_pool">While mining, the app connects to the pool Catch That Rabbit. It sees your address, the name in the pool (e.g. phone-7k2f), your computing power and your IP address. Anyone who looks up your address in the pool statistics can see the name and the computing power.</string>
    <string name="consent_notice">License and liability (NOTICE)</string>
    <string name="consent_agree">I have read the notes and agree.</string>
    <string name="consent_need">Tick the box to start.</string>

