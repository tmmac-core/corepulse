    <!-- ===== About this app ===== -->
    <string name="about_title">About this app</string>
    <string name="about_back">← Back</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_publisher_title">Publisher</string>
    <string name="about_publisher_body" formatted="false">TMMAC – Tell Me More About Core. We explain the Core ecosystem and build tools for it. No account, no tracking. 0.42% of the computing time supports further development.</string>
    <string name="about_legal_imprint">Legal notice</string>
    <string name="about_legal_privacy">Privacy policy</string>
    <string name="about_feedback">Feedback &amp; bug reports</string>
    <!-- %1$s = Knopf "Details und Log", %2$s = Knopf "Log kopieren" -->
    <string name="about_feedback_hint">For a bug, the log helps: “%1$s” → “%2$s”, then paste it into the form.</string>
    <string name="about_xcb_title">What is XCB?</string>
    <string name="about_xcb_body">XCB (Core Coin) is the currency of the Core network. New XCB are created by mining: computers solve tasks with the RandomY method, which is made for normal processors – that\'s why a phone can join in too. The more people mine, the more widely spread the network is.</string>
    <string name="about_connections_title">What the app sends</string>
    <string name="about_connection_pool">To the pool Catch That Rabbit: your address, the name in the pool, your computing power and your computing results. Unencrypted, because the pool offers nothing else.</string>
    <string name="about_connection_stats">For earnings and balance, the app asks the statistics of the same pool (encrypted).</string>
    <string name="about_connection_support">For the support time, the app computes for TMMAC over a second connection, 25 seconds every 100 minutes.</string>
    <string name="about_connections_none">Nothing else: no analytics, no ads, no cloud. Your details stay on your phone.</string>
    <string name="about_license_title">License</string>
    <string name="about_license_body">Open-source software (GPL-3.0). Anyone who builds on it and passes it on must publish their source code and show “Based on CorePulse by TMMAC”.</string>
    <string name="about_source">Source code of this version</string>
    <string name="about_license_notice">License and additional terms (NOTICE)</string>
    <string name="about_license_gpl">GPL-3.0 (full text)</string>
    <string name="about_oss_title">All license texts</string>
    <!-- %1$s = label of the license link -->
