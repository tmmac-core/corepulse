<?xml version="1.0" encoding="utf-8"?>
<!-- Nichts verlaesst das Geraet (Daten bleiben auf dem Handy):
     weder Cloud-Backup noch Uebertragung auf ein neues Geraet (Android 12+).
     allowBackup=false allein deckt den Geraete-Umzug ab Android 12 nicht ab. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
