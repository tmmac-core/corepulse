<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 12 zeigt das System beim Kaltstart einen Startbildschirm: auf Canvas, das Symbol pulst einmal
         (splash_icon.xml). Nur Theme-Attribute, keine Splash-Bibliothek. -->
    <style name="Theme.Miner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowSplashScreenBackground">@color/canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>
</resources>
